-- IMPORTS
import qualified Sound.Osc.Fd as O
import qualified Sound.Osc.Transport.Fd.Udp as O

-- SIDECHAINING
scUdp <- O.openUdp "127.0.0.1" 57120

createSidechain sourceOrbit controlOrbit slopeAbove clampTime relaxTime = do 
    O.sendMessage scUdp (O.message "/createSidechain" [O.int32 sourceOrbit, O.int32 controlOrbit, O.float slopeAbove, O.float clampTime, O.float relaxTime])

deleteSidechain sourceOrbit controlOrbit = do
    O.sendMessage scUdp (O.message "/deleteSidechain" [O.int32 sourceOrbit, O.int32 controlOrbit])

clearSidechains = do
    O.sendMessage scUdp (O.message "/clearSidechains" [])

-- SYNTHESIZERS
waveform = pF "waveform"
unison = pF "unison"
detune1 = pF "detune1"
detune2 = pF "detune2"
scatter1 = pF "scatter1"
scatter2 = pF "scatter2"
instability = pF "instability"
phase = pF "phase"
pulse = pF "pulse"

-- UTILS
accelerateSemitones semitones = 2 ** (semitones / 12) - 1
chorus (cAmp, cPan, cWidth, cNudge) (pattern) = stack [pattern # amp (cAmp / 2) # pan (cPan - (cWidth / 2)) # nudge cNudge, pattern # amp (cAmp / 2) # pan (cPan + (cWidth / 2))]
setBPM bpm = setcps(bpm / 60 / 4) -- in case setbpm does not exist

-- SIMMONS SDSV
cymbal = sound "SimmonsCymbals:0" # amp 0.6 # coarse 1.8 # room 0.3 # size 0.9
hihat = chorus (0.2, 0.5, 0.9, 0.005) (sound "SimmonsHiHat:1" # room 0.2 # size 0.9)
kick = sound "EmuKick:10" # amp 0.8 # shape 0.2 # end 0.7 # room 0.06 # size 0.6
snare = stack [sound "SimmonsSnare:12" # amp 0.45 # shape 0.6 # speed (2 ** (-1.5 / 12)) # hpf 300 # orbit 12, sound "supernoise" # amp 0.5 # voice 0.85 # sustain 0.85 # release 0.85 # ring 0.2 # ringf 55 # ringdf (-35) # bpf 2900 # room 0.25 # size 0.9] 
toms = sound "SimmonsToms:16" # amp 0.7 # coarse 1.6 # room 0.07 # size 0.85
toms1 = toms # speed (2 ** (9 / 12)) # pan 0.2 -- af
toms2 = toms # speed (2 ** (4 / 12)) # pan 0.35 -- ef
toms3 = toms # pan 0.65 -- b
toms4 = toms # speed (2 ** (-3 / 12)) # pan 0.8 -- af

-- BASS
bassR = 0.21 -- 0.21 @ 75 BPM, 0.25 @ 60 BPM
bass1 = sound "moogan" # amp 0.9 # sustain 0.3 # release bassR # waveform 3 # unison 6 # detune1 0.01 # scatter1 0.2 # lfo 0.3 # rate 0.8 # resonance 0.05
bass2 = sound "moogan" # amp 0.3 # sustain 0.3 # release bassR # waveform 3 # unison 3 # detune1 0.01 # lfo 0.3 # rate 0.8 # resonance 0.05 # phase 0.4 # octave 4
bass = stack [bass1, bass2] # room 0.25 # size 0.85

-- EVENT HORIZON MID
eventHorizonMid1 = sound "moogan" # amp 1.4 # waveform 3 # unison 7 # detune1 0.071 # detune2 (-0.029) # scatter1 0.5 # scatter2 0.5 # lfo 6.5 # rate 0.05 # resonance 0.3 # instability 0.1 # hpf 300
eventHorizonMid2 = sound "moogan" # amp 0.4 # waveform 1 # unison 2 # detune1 0.013 # scatter1 1.0 # lfo 6 # rate 0.05 # resonance 0.2 # phase 0.4 # hpf 300
eventHorizonMid = stack [eventHorizonMid1, eventHorizonMid2] # room 0.25 # size 0.9

-- EVENT HORIZON LEAD
eventHorizonLead1 = sound "moogan" # amp 0.3 # waveform 1 # unison 2 # detune1 0.004 # scatter1 0.6 # lfo 15 # rate 0 # resonance 0.3 # phase 0.1
eventHorizonLead2 = sound "moogan" # amp 1.1 # waveform 3 # unison 6 # detune1 0.008 # detune2 (-0.006) # scatter2 0.6 # lfo 15.0 # rate 0 # resonance 0.3 # instability 0.08 # octave 4
eventHorizonLead = stack [eventHorizonLead1, eventHorizonLead2] # sustain 1.3 # release 1.3 # phasr 2 # phasdp 0.4 # room 0.25 # size 0.9

-- EVENT HORIZON BRASS
eventHorizonBrass = sound "moogan"

-- NEBULA NINE MID
nebulaNineMid1 = sound "moogan" # amp 0.09 # waveform 2 # unison 2 # detune1 0.013 # scatter1 0.35 # lfo 7 # rate 0 # pulse 0.2 # resonance 0.39 # hpf 200 
nebulaNineMid2 = nebulaNineMid1 # pulse 0.15
nebulaNineMid = stack [nebulaNineMid1, nebulaNineMid2] # room 0.4 # size 0.9

-- NEBULA NINE LEAD
nebulaNineLead1 = sound "moogan" # amp 0.47 # attack 0.05 # sustain 1.2 # release 1.2 # waveform 3 # unison 4 # detune1 0.014 # detune2 (-0.003) # scatter2 0.8 # lfo 0.05 # rate 0 # resonance 0.04 # lpf 5500
nebulaNineLead2 = nebulaNineLead1 # amp 0.32 # octave 4 
nebulaNineLead3 = sound "moogan" # amp 0.02 # attack 0.05 # sustain 1.2 # release 1.2 # waveform 1 # lfo 0.01 # rate 0.06 # resonance 0.01 # octave 4
nebulaNineLead = stack [nebulaNineLead1, nebulaNineLead2, nebulaNineLead3] # room 0.4 # size 0.9

-- EXPERIMENTAL LEAD
experimentalLead1 = sound "moogan" # amp 0.04 # waveform 1 # unison 2 # detune1 0.01 # scatter1 0.8 # lfo 10 # rate 0 # phase 0.45
experimentalLead2 = sound "moogan" # amp 0.6 # waveform 3 # unison 4 # detune1 0.02 # scatter2 0.8 # lfo 9 # rate 0 # resonance 0.5
experimentalLead3 = sound "moogan" # amp 1.1 # waveform 3 # unison 4 # detune1 0.02 # scatter2 0.8 # lfo 5 # rate 0 # resonance 0.3 # phase 0.41 # octave 4
experimentalLead = stack [experimentalLead1, experimentalLead2, experimentalLead3] # sustain 0.6 # release 0.6 # crush 6.5 # distort 0.12 # room 0.4 # size 0.9

-- EXPERIMENT
setbpm(75)
createSidechain 8 0 0.7 0.001 0.1
d1 $ note "c*4" # kick
d2 $ note "~ c ~ c" # snare
d3 $ note "c*8" # hihat
d4 $ slow 2 (note "c") # cymbal
d5 $ slowcat [note "~", note "~ ~ ~ [c ~ ~ ~]"] # toms1
d6 $ slowcat [note "~", note "~ ~ ~ [~ c ~ ~]"] # toms2
d7 $ slowcat [note "~", note "~ ~ ~ [~ ~ c ~]"] # toms3
d8 $ slowcat [note "~", note "~ ~ ~ [~ ~ ~ c]"] # toms4
d9 $ note "d3*16" # bass

panic
hush