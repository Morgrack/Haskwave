-- IMPORTS
import qualified Sound.Osc.Fd as O
import qualified Sound.Osc.Transport.Fd.Udp as O

-- UTILS
scUdp <- O.openUdp "127.0.0.1" 57120

makeSidechain sourceOrbit controlOrbit slopeAbove clampTime relaxTime = do 
    O.sendMessage scUdp (O.message "/makeSidechain" [O.int32 sourceOrbit, O.int32 controlOrbit, O.float slopeAbove, O.float clampTime, O.float relaxTime])

clearSidechain sourceOrbit controlOrbit = do
    O.sendMessage scUdp (O.message "/clearSidechain" [O.int32 sourceOrbit, O.int32 controlOrbit])

clearAllSidechains = do
    O.sendMessage scUdp (O.message "/clearAllSidechains" [])

setBPM bpm = setcps(bpm / 60 / 4) -- in case setbpm does not exist, uses 4/4 time signature

unison count (pBase, pWidth, vBase, vWidth, sWidth, aLevel) (synthPattern) = stack newPatterns
    where
        countNum = fromIntegral count
        pFirst = pBase - (pWidth / 2)
        vFirst = vBase - (vWidth / 2)
        sFirst = 1.0 - (sWidth / 2)
        pStep = pWidth / (countNum - 1)
        vStep = vWidth / (countNum - 1)
        sStep = sWidth / (countNum - 1)
        aDivided = aLevel / countNum
        newPatterns = [(synthPattern # pan (pFirst + pStep * fromIntegral i) # voice (vFirst + vStep * fromIntegral i) # speed (sFirst + sStep * fromIntegral i) # amp aDivided) | i <- [0..(count - 1)]]

-- E-MU DRUMULATOR
anvil = sound "Metallic:0" # speed (2 ** (-6 / 12)) # amp 0.06 # shape 0.85 # coarse (1.7 + rand * 0.6) # krush 0.25 # pan (0.45 + rand * 0.1) # room 0.3 # size 0.7
hihat = stack [sound "EmuHiHat:1" # pan 0.1 # nudge 0.005, sound "EmuHiHat:1" # pan 0.9] # amp 0.18 # coarse 1.6
kick = sound "EmuKick:3" # amp 0.9 # shape 0.2 # coarse 1.53
snare1 = sound "EmuSnare:0" # amp 0.6 # coarse 1.6 # shape 0.5 # hpf 175 # room 0.08 # size 0.7
snare2 = sound "EmuSnare:8" # amp 0.9 # coarse 1.6 # shape 0.7 # hpf 175 # room 0.04 # size 0.7
snare3 = sound "EmuSnare:9" # amp 0.3 # crush 7.0 # shape 0.9 # speed 1.01 # room 0.2 # size 0.7
snare4 = sound "EmuSnare:11" # amp 1.0 # coarse 1.74 # shape 0.8 # speed 1.02 # hpf 200 # room 0.04 # size 0.7
toms = shape 0.3 # hpf 250 # room 0.15 # size 0.7
toms1 = toms # sound "EmuToms:8" # amp 0.85 # pan 0.3 -- d
toms2 = toms # sound "EmuToms:9" # amp 0.9 # pan 0.4 -- a
toms3 = toms # sound "EmuToms:9" # amp 0.9 # pan 0.55 # speed (2 ** (-4 / 12)) -- f
toms4 = toms # sound "EmuToms:10" # amp 0.75 # pan 0.65 -- d

-- DIVERGENCE BASS
divergenceBassR = 0.17 -- 0.135 @ 140 BPM / 0.22 @ 130 BPM / 0.17 @ 87 BPM
divergenceBass1 = unison 2 (0.5, 0.6, 1.2, 0.1, 0.037, 0.85) (sound "supersaw" # attack 0.022 # sustain 0.23 # release divergenceBassR # lfo 10 # rate 1.2 # resonance 0.35 # coarse 2.15 # shape 0.5 # hpf 100)
divergenceBass2 = sound "supersaw" # voice 0.1 # amp 0.45 # attack 0.022 # sustain 0.23 # release divergenceBassR # lfo 1.0 # rate 1.2 # resonance 0.1 # lpf 100 # octave 4 
divergenceBass = stack [divergenceBass1, divergenceBass2] # room 0.2 # size 0.7

-- EXPERIMENT
experiment1 = unison 2 (0.5, 0.9, 1.0, 0.15, 0.00, 0.28) (sound "supernoise" # attack 0.15 # release 999 # resonance 0.01 # hpf 100 # coarse 1.55 # distort 0.73 # shape 0.5)
experiment2 = unison 2 (0.5, 0.75, 1.15, 0.1, 0.015, 1.1) (sound "supersaw" # lfo 1.0 # rate 0.1 # resonance 0.65 # crush 3.0 # coarse 1.7 # bpf 67 # bpq 10 # hpf 120)
experiment3 = unison 2 (0.5, 0.6, 0.7, 0.1, 0.01, 0.4) (sound "supersaw" # attack 0.15 # release 999 # lfo 6.0 # rate 0.8 # resonance 0.05 # lpf 6000 # octave 4)
experiment = stack [experiment1, experiment2, experiment3] # room 0.35 # size 0.7

-- EXPERIMENT
experimentR = 0.13
experiment1 = unison 2 (0.5, 0.3, 0.6, 0.2, (-0.01), 0.4) (sound "supersquare" # sustain 0.15 # release experimentR # lfo 6.0 # rate 0.1 # resonance 0.38 # shape 0.3)
experiment2 = sound "supersquare" # voice 0.4 # amp 0.75 # sustain 0.15 # release experimentR # lfo 1.0 # rate 0.1 # resonance 0.1 # octave 4
experiment = stack [experiment1, experiment2] # room 0.3 # size 0.8

-- EXPERIMENT
setbpm(140)
makeSidechain 8 0 0.9 0.001 0.1
d1 $ note "c*4" # kick
d2 $ note "[~ c]*2" # snare1
d3 $ slowcat [note "c*12", note "[c*3] [c*3] [c*3] [c*6]"] # hihat
d4 $ slowcat [note "~", note "~", note "~", note "~ ~ [~ ~ c] ~"] # toms1
d5 $ slowcat [note "~", note "~", note "~", note "~ ~ ~ [c ~ ~]"] # toms2
d6 $ slowcat [note "~", note "~", note "~", note "~ ~ ~ [~ c ~]"] # toms3
d7 $ slowcat [note "~", note "~", note "~", note "~ ~ ~ [~ ~ c]"] # toms4
d8 $ slowcat [note "[e5 fs5] [g5 fs5 e5]", note "[a5 g5 fs5] [g5 fs5 ds5]", note "[e5 fs5] [g5 fs5 a5]", note "[b5 c6 b5] [b5 c6 b5]"] # anvil
d9 $ note "e3*12" # divergenceBass


unison = pF "unison"
waveform = pF "waveform"
detune = pF "detune"
scatter = pF "scatter"
pulse = pF "pulse"

d1 $ note "f gs" # sound "moogan" # octave 3 # waveform 3 # unison 2 # lfo 10 # rate 0.1 # scatter 0.5 # detune 0.015 # crush 2.7 # bpf 93 # bpq 11 # hpf 150 # amp 0.8

