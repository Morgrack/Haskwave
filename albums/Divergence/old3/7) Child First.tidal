setbpm(120) -- low growly range simple simple synth with marching
setbpm(100)

-- chorus
d1 $ note "c*4" # kick
d2 $ note "[~ c]*2" # snare1
d3 $ slowcat [note "c c ~ c c ~ c c ~ c c ~ c ~ ~ ~", note "c c ~ c c ~ c c ~ c [c c c c] [c c c c] c ~ c c"] # hihat
d4 $ slowcat [note "[fs4 fs4 e4 ~] [fs4 ~ e4 g4] [fs4 fs4 e4 ~] [a4 as4 b4 c5 cs5]", note "[fs4 fs4 e4 ~] [fs4 ~ e4 g4] [fs4 fs4 e4 ~] [a4 g4]"] # sound "superpiano" -- Behemoth style bass

-- verse
d1 $ slowcat 
    [
        note "[fs4 fs4 fs4 ~] [fs4 ~ fs4 fs4] [a4 a4 a4 ~] [g4 ~ g4 g4]", note "[fs4 fs4 fs4 ~] [fs4 ~ fs4 fs4] [fs4 fs4 fs4 ~] [fs4 ~ fs4 fs4]",
        note "[fs4 fs4 fs4 ~] [fs4 ~ fs4 fs4] [b4 b4 b4 ~] [gs4 ~ gs4 gs4]", note "[fs4 fs4 fs4 ~] [fs4 ~ fs4 fs4] [fs4 fs4 fs4 ~] [fs4 ~ fs4 fs4]",
        note "[fs4 fs4 fs4 ~] [fs4 ~ fs4 fs4] [a4 a4 a4 ~] [g4 ~ g4 g4]", note "[fs4 fs4 fs4 ~] [fs4 ~ fs4 fs4] [fs4 fs4 fs4 ~] [fs4 ~ fs4 fs4]",
        note "[fs4 fs4 fs4 ~] [fs4 ~ fs4 fs4] [b4 b4 b4 ~] [gs4 ~ gs4 gs4]", note "[as4 as4 as4 ~] [as4 ~ as4 as4] [as4 as4 as4 ~] [as4 ~ as4 as4]"
    ] # sound "superpiano" 

-- bass boosted march kick
