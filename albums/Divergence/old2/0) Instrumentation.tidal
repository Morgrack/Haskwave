--EXPERIMENTATION 7
setbpm(75)

kick = sound "EmuKick:10" # amp 0.7 # shape 0.4
snare = stack [sound "hardcore:3" # amp 0.9 # shape 0.8 # gain 0.85, sound "SimmonsSnare:14" # amp 0.6 # shape 0.2] # room 0.45 # size 0.8
hihat = stack [sound "SimmonsHiHat:1" # amp 0.27 # pan 0.1 # nudge 0.005, sound "SimmonsHiHat:1" # amp 0.27 # pan 0.9] # room 0.3 # size 0.9
lead = chorus (0.5, 0.45, 0.07, 0.04, 0.006, 0.3) (sound "supersaw" # sustain 1.3 # release 1.3 # lfo 15.0 # rate 0.05 # resonance 0.3) # room 0.25 # size 0.9
mid = chorus (0.5, 0.4, 0.4, 0.03, 0.01, 0.4) (sound "supersaw" # lfo 6 # rate 0.05 # resonance 0.3 # hpf 300) # room 0.25 # size 0.9 
bass1 = chorus (0.5, 0.1, 0.2, 0.05, 0.00, 0.25) (sound "supersaw" # sustain 0.3 # release 0.21 # lfo 0.2 # rate 0.8 # resonance 0.05)
bass2 = sound "supersaw" # voice 0.7 # amp 0.65 # nudge 0.03 # sustain 0.3 # release 0.21 # lfo 1.0 # octave 4 # lpf 100
bass = stack [bass1, bass2] # room 0.25 # size 0.85

do 
    makeSideChain 0 3 0.8 0.001 0.1
    makeSideChain 1 3 0.8 0001 0.1
    makeSideChain 2 3 0.5 0.001 0.04

-- EVENT HORIZON


hush
-- INTRO
do 
    let filterSweep = djf $ range 1.0 0.5 $ (slow 8 saw) -- apply this to each track separately as is easier than having to handle orbit reverb in a stack
    d1 $ slowcat [note "[[af5 e5] [ef5 b4]]*2", note "[af5 e5] [ef5 b4] [bf4 b4] [df5 ef5]"] # lead # filterSweep 
    d2 $ slowcat [note "af3 ~ ~ ~" # legato 7.3, note "~ ~ ~ a3", note "b3 ~ ~ ~" # legato 7.3, note "~ ~ ~ a3"] # mid # filterSweep
    d3 $ slowcat [note "ef3*16", note "[ef3*4] [ef3*4] [ef3*4] [e3*4]", note "fs3*16", note "[fs3*4] [fs3*4] [fs3*4] [e3*4]"] # bass # gain 1.1 # filterSweep
    -- whispering poetry aboard a space ship

-- CHORUS
do
    d1 $ slowcat [note "[[af5 e5] [ef5 b4]]*2", note "[af5 e5] [ef5 b4] [bf4 b4] [df5 ef5]"] # lead
    d2 $ slowcat [note "af3 ~ ~ ~" # legato 7.3, note "~ ~ ~ a3", note "b3 ~ ~ ~" # legato 7.3, note "~ ~ ~ a3"] # mid
    d3 $ slowcat [note "ef3*16", note "[ef3*4] [ef3*4] [ef3*4] [e3*4]", note "fs3*16", note "[fs3*4] [fs3*4] [fs3*4] [e3*4]"] # bass # gain 1.1
    d4 $ note "c*4" # kick
    d5 $ note "~ c ~ c" # snare
    -- falling white noise
    -- coarse simmons toms
    -- very chorus pad

-- VERSE
do
    d2 silence
    -- change up lead a bit
    d6 $ note "c*8" # hihat # gain "<1 0.8>*8" --only for latter half
    -- rising white noise
    -- coarse simmons toms
    -- whispering poetry aboard a space ship

-- CHORUS
do 
    d2 $ slowcat [note "af3 ~ ~ ~" # legato 7.3, note "~ ~ ~ a3", note "b3 ~ ~ ~" # legato 7.3, note "~ ~ ~ a3"] # mid
    d6 silence
    -- falling white noise
    -- coarse simmons toms
    -- very chorus pad

-- VERSE
do
    d2 silence
    d6 $ note "c*8" # hihat # gain "<1 0.8>*8"
    -- rising
    -- coarse simmons toms
    -- whispering poetry aboard a space ship

-- CHORUS
do
    d2 $ slowcat [note "af3 ~ ~ ~" # legato 7.3, note "~ ~ ~ a3", note "b3 ~ ~ ~" # legato 7.3, note "~ ~ ~ a3"] # mid
    d6 silence
    -- falling white noise
    -- coarse simmons toms
    -- very chorus pad

-- BRIDGE
do 
    d4 silence
    d5 silence
    d6 $ slowcat ((replicate 6 (note "c*4")) ++ [note "c*8", note "[c*4] [c*6]"]) # hihat
    -- rising white noise
    -- coarse simmons toms but slightly longer pattern
    -- whispering poetry aboard a space ship, very intense ending in screaming as we enter the event horizon
    -- space ship blasting through space, soaring sounds

-- CHORUS (2x)
do 
    d4 $ note "c*4" # kick
    d5 $ note "~ c ~ c" # snare
    d6 silence
    -- we introduce du duuuuuu du duuuuu du duuuuuu du du duuu synth on top of everything
    -- falling white noise
    -- very chorus pad

-- OUTRO
do
    d2 $ slowcat [note "af3 ~ ~ ~" # legato 7.3, note "~ ~ ~ a3", note "af3 ~ ~ ~" # legato 7.3, note "~ ~ ~ gf3"] # mid
    d3 silence
    d5 silence

hush

setbpm(160)
kick1 = sound "hardcore:5" # amp 1.0
kick2 = sound "hardcore:4" # amp 1.6
hihat = sound "hardcore:0" # amp 1.0
snare = sound "hardcore:3" # amp 0.7 # shape 0.8
stuff = sound "hardcore:5" # amp 1.0
d2 $ note "c*4" # kick1
d3 $ note "c*4" # kick2
d4 $ note "~ c ~ c" # snare
d5 $ swingBy (1/4) 4 $ note "c*8" # hihat
brynth1 = chorus (0.5, 0.7, 0.25, 0.05, 0.02, 0.14) (sound "supersaw" # lfo 20.0 # rate 0.01 # resonance 0.5 # shape 0.7 # crush 3.0)
brynth2 = chorus (0.5, 0.7, 1.0, 0.1, 0, 0.1) (sound "supernoise" # shape 0.2)
brynth = stack [brynth1, brynth2]
d1 $ slowcat [note "d6 cs6 b5 ~ f6 ~ ~ ~" # legato "1 1 1 1 3 1 1 1", note "fs6 ~"] # brynth

hush