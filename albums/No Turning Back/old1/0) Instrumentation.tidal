-- IMPORTS
import qualified Sound.Osc.Fd as O
import qualified Sound.Osc.Transport.Fd.Udp as O

-- UTILS
scUdp <- O.openUdp "127.0.0.1" 57120

makeSidechain sourceOrbit controlOrbit slopeAbove clampTime relaxTime = do 
    O.sendMessage scUdp (O.message "/makeSidechain" [O.int32 sourceOrbit, O.int32 controlOrbit, O.float slopeAbove, O.float clampTime, O.float relaxTime])

clearSidechain sourceOrbit controlOrbit = do
    O.sendMessage scUdp (O.message "/clearSidechain" [O.int32 sourceOrbit, O.int32 controlOrbit])

clearAllSidechains = do
    O.sendMessage scUdp (O.message "/clearAllSidechains" [])

setBPM bpm = setcps(bpm / 60 / 4) -- in case setbpm does not exist, uses 4/4 time signature

unison count (pBase, pWidth, vBase, vWidth, sWidth, aLevel) (synthPattern) = stack newPatterns
    where
        countNum = fromIntegral count
        pFirst = pBase - (pWidth / 2)
        vFirst = vBase - (vWidth / 2)
        sFirst = 1.0 - (sWidth / 2)
        pStep = pWidth / (countNum - 1)
        vStep = vWidth / (countNum - 1)
        sStep = sWidth / (countNum - 1)
        aDivided = aLevel / countNum
        newPatterns = [(synthPattern # pan (pFirst + pStep * fromIntegral i) # voice (vFirst + vStep * fromIntegral i) # speed (sFirst + sStep * fromIntegral i) # amp aDivided) | i <- [0..(count - 1)]]

-- SIMMONS SDSV
kick = sound "EmuKick:10" # amp 0.8 # shape 0.4 # end 0.7
snare = stack [sound "SimmonsSnare:12" # amp 0.9 # shape 0.4 # speed 0.9 # hpf 300 # orbit 185, sound "supernoise" # amp 0.2 # voice 0.85 # sustain 1.3 # release 1.1 # hpf 300 # lpf 5000 # room 0.6 # size 0.9] 
hihatClosed = stack [sound "SimmonsHiHat:1" # pan 0.1 # nudge 0.005, sound "SimmonsHiHat:1" # pan 0.9] # amp 0.2 # room 0.2 # size 0.9
hihatPartial = stack [sound "SimmonsHiHat:5" # pan 0.1 # nudge 0.005, sound "SimmonsHiHat:5" # pan 0.9] # amp 0.25 # room 0.3 # size 0.9
hihatOpen = stack [sound "SimmonsHiHat:4" # pan 0.1 # nudge 0.005, sound "SimmonsHiHat:4" # pan 0.9] # amp 0.3 # room 0.3 # size 0.9 # speed (2 ** (7 / 12))
-- cymbals
toms = sound "SimmonsToms:16" # amp 0.9 # coarse 1.6 # room 0.07 # size 0.85
toms1 = toms # speed (2 ** (9 / 12)) # pan 0.2 -- af
toms2 = toms # speed (2 ** (4 / 12)) # pan 0.35 -- ef
toms3 = toms # pan 0.65 -- b
toms4 = toms # speed (2 ** (-3 / 12)) # pan 0.8 -- af

-- NO TURNING BACK BASS
noTurningBackBassR = 0.21 -- 0.21 @ 75 BPM, 0.25 @ 60 BPM
noTurningBackBass1 = unison 2 (0.5, 0.1, 0.2, 0.05, 0.00, 0.55) (sound "supersaw" # sustain 0.3 # release noTurningBackBassR # lfo 0.2 # rate 0.8 # resonance 0.05)
noTurningBackBass2 = sound "supersaw" # voice 0.7 # amp 0.7 # nudge 0.03 # sustain 0.3 # release noTurningBackBassR # lfo 1.0 # octave 4 # lpf 100
noTurningBackBass = stack [noTurningBackBass1, noTurningBackBass2] # room 0.25 # size 0.85

-- EVENT HORIZON LEAD
eventHorizonLead = unison 2 (0.5, 0.6, 0.07, 0.04, 0.006, 0.6) (sound "supersaw" # sustain 1.3 # release 1.3 # lfo 15.0 # rate 0.05 # resonance 0.3) # room 0.25 # size 0.9

-- EVENT HORIZON MID
eventHorizonMid = unison 2 (0.5, 0.4, 0.4, 0.03, 0.01, 0.75) (sound "supersaw" # lfo 6 # rate 0.05 # resonance 0.3 # hpf 300) # room 0.25 # size 0.9

-- EVENT HORIZON BRASS
eventHorizonBrass1 = unison 2 (0.5, 0.85, 0.0001, 0, 0.006, 0.08) (sound "supersaw" # lfo 3 # rate 0.001 # resonance 0.5)
eventHorizonBrass2 = unison 2 (0.5, 0.75, 0.0001, 0, 0.012, 0.18) (sound "supersaw" # lfo 5 # rate 0.001 # resonance 0.4 # octave 4)
eventHorizonBrass3 = unison 2 (0.5, 0.65, 0.0001, 0, 0.0105, 0.2) (sound "supersaw" # lfo 5 # rate 0.001 # resonance 0.4 # octave 4)
eventHorizonBrass = stack [eventHorizonBrass1, eventHorizonBrass2, eventHorizonBrass3] # shape 0.2 # room 0.5 # size 0.95

-- EXPERIMENT
setbpm(75)
makeSidechain 7 0 0.75 0.001 0.1
d1 $ note "c*4" # kick
d2 $ note "[~ c]*2" # snare
d3 $ note "c*8" # hihatClosed
d4 $ slowcat [note "~", note "~ ~ ~ [c ~ ~ ~]"] # toms1
d5 $ slowcat [note "~", note "~ ~ ~ [~ c ~ ~]"] # toms2
d6 $ slowcat [note "~", note "~ ~ ~ [~ ~ c ~]"] # toms3
d7 $ slowcat [note "~", note "~ ~ ~ [~ ~ ~ c]"] # toms4
d8 $ note "d3*16" # noTurningBackBass

-- EXPERIMENT
setbpm(95)
d1 $ slowcat [note "fs5", note "~", note "f5", note "~", note "a5", note "~"] # sound "superpiano" # room 0.3 # size 0.9 -- like eventHorizonMid but higher octave, also have a growling swapping between ears on arpeggio downwards on the beat
d2 $ slowcat [note "as5", note "~", note "a5", note "~", note "cs6", note "~"] # sound "superpiano" # room 0.3 # size 0.9
d3 $ slowcat [note "fs3*16", note "fs3*16", note "f3*16", note "f3*16", note "a3*16", note "a3*16"] # sound "superpiano" # amp 0.2

-- EXPERIMENT
setbpm(95)
d1 $ slowcat [note "fs5 ~ ~ gs5", note "as5 ~ ~ fs5", note "a5 ~ ~ fs5", note "as5 ~ a5 gs5"] # sound "superpiano" # room 0.3 # size 0.9
d2 $ slowcat [note "fs3*16", note "f3*16", note "gs3*16", note "gs3*8 g3*8"] # sound "superpiano" # amp 0.2

-- EXPERIMENT
setbpm(70)
d1 $ slowcat [note "[e5 c5] [e5 c5] [e5 c5] fs5", note "[e5 c5] [e5 c5] [e5 c5] fs5", note "[e5 b4] [e5 b4] [e5 b4] fs5", note "[e5 b4] [e5 b4] [e5 b4] fs5"] # sound "superpiano" # room 0.3 # size 0.9
d1 $ slowcat [note "c5 [~ a4] c5 d5", note "b4 [~ g4] b4 c5", note "a4 [~ [f4 g4]] a4 b4", note "g4"] # sound "superpiano" # room 0.3 # size 0.9

hush