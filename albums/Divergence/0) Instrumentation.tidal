-- IMPORTS
import qualified Sound.Osc.Fd as O
import qualified Sound.Osc.Transport.Fd.Udp as O

-- UTILS
scUdp <- O.openUdp "127.0.0.1" 57120

makeSideChain sourceOrbit controlOrbit slopeAbove clampTime relaxTime = do 
    O.sendMessage scUdp (O.message "/makeSidechain" [O.int32 sourceOrbit, O.int32 controlOrbit, O.float slopeAbove, O.float clampTime, O.float relaxTime])

clearSideChain sourceOrbit controlOrbit = do
    O.sendMessage scUdp (O.message "/clearSidechain" [O.int32 sourceOrbit, O.int32 controlOrbit])

clearAllSideChains = do
    O.sendMessage scUdp (O.message "/clearAllSidechains" []) --TODO: fix this

chorus vBase vWidth pWidth sWidth aAmount p = stack [(p # voice (vBase + (vWidth / 2)) # pan (0.5 + (pWidth / 2)) # speed (1.0 + (sWidth / 2)) # amp aAmount), (p # voice (vBase - (vWidth / 2)) # pan (0.5 - (pWidth / 2)) # speed (1.0 - (sWidth / 2)) # amp aAmount)] 

setBPM bpm = setcps(bpm / 60 / 4) -- in case setbpm does not exist, uses 4/4 time signature

-- PROPHECY LEAD
prophecyLead1 = chorus 0.9 0.1 1.0 0.0 0.7 (sound "supersaw" # sustain 0.25 # release 0.25 # lfo 1.0 # rate 0.1 # resonance 0.7 # crush 2.5 # bpf 70 # bpq 10 # hpf 150)
prophecyLead2 = chorus 0.9 0.1 1.0 0.0 0.6 (sound "supersaw" # attack 0.05 # release 999 # lfo 1.0 # rate 0.1 # resonance 0.7 # crush 2.5 # bpf 70 # bpq 10 # hpf 120)
prophecyLead3 = chorus 8.0 0.1 0.9 0.0 0.5 (sound "supersaw" # attack 0.05 # release 999 # lfo 0.25 # rate 0.01 # resonance 0.9 # distort 0.7 # bpf 50 # bpq 5 # hpf 200)
prophecyLead4 = chorus 1.0 0.0 0.8 0.0 0.45 (sound "supernoise" # attack 0.05 # release 999 # resonance 0.2 # distort 0.25 # phasdp 0.7 # phasr 5.0 # hpf 150)
prophecyLead5 = chorus 0.7 0.1 0.7 0.0 0.2 (sound "supersaw" # attack 0.05 # release 999 # lfo 7.0 # rate 0.005 # resonance 0.01 # hpf 100 # lpf 7000)
prophecyLead6 = sound "supersaw" # voice 0.05 # amp 0.2 # attack 0.05 # release 999 # lfo 1.0 # rate 0.001 # octave 4 # lpf 200
prophecyLead = stack [prophecyLead1, prophecyLead2, prophecyLead3, prophecyLead4, prophecyLead5, prophecyLead6] # room 0.15 # size 0.9

-- KNIFE'S EDGE LEAD
knifesEdgeLead = chorus 0.7 0.1 0.1 0.015 0.045 (sound "supersaw" # lfo 1.0 # crush 1.5 # resonance 0.15 # phasdp 2.0 # phasr 0.5 # hpf 200 # lpf 12000) # room 0.3 # size 0.9

-- BASS
releaseBase = 0.15 -- 0.17 @ 80 BPM
bass1 = chorus 0.8 0.1 0.8 0.02 0.1 (sound "supersaw" # sustain 0.2 # release (releaseBase - 0.02) # lfo 16.0 # resonance 0.3 # shape 0.8 # distort 0.3 # hpf 500)
bass2 = chorus 1.2 0.1 0.6 0.037 0.47 (sound "supersaw" # attack 0.04 # sustain 0.2 # release releaseBase # lfo 10.0 # resonance 0.25 # shape 0.4 # hpf 100)
bass3 = sound "supersaw" # voice 0.1 # amp 0.9 # attack 0.04 # release releaseBase # lfo 1.0 # octave 4 # lpf 100
bass = stack [bass1, bass2, bass3] # room 0.17 # size 0.8

-- DRUMS
clap = sound "EmuPercussion:3" # amp 1.2 # room 0.04 # size 0.8
cowbell = sound "EmuPercussion:7" # amp 0.8 # room 0.02 # size 0.8
heartbeat = sound "EmuKick:9" # amp 1.0 # room 0.05 # size 0.8 # lpf 2500
kick = sound "EmuKick:2" # amp 1.2 # shape (-0.25) -- af
slap = sound "EmuPercussion:9" # amp 1.0 # room 0.04 # size 0.8
swipe = sound "EmuPercussion:8" # amp 1.1 # room 0.04 # size 0.8
woodblock = sound "EmuPercussion:12" # amp 0.8 # room 0.01 # size 0.8
agogoHigh = sound "EmuPercussion:0" # amp 0.7 # room 0.1 # size 0.7 # distort 0.7 # hpf 250
agogoLow = sound "EmuPercussion:1" # amp 0.6 # room 0.1 # size 0.7 # distort 0.7
cymbalChina = sound "EmuCymbals:0" # amp 0.4 # room 0.2 # size 0.8
cymbalCrash = sound "OberheimCymbals:0" # amp 0.85 # room 0.2 # size 0.8 # shape 0.2 # speed 0.98
cymbalRide = sound "OberheimCymbals:1" # amp 0.4 # room 0.2 # size 0.8
hihatClosed = sound "EmuHiHat:0" # amp 0.3 # room 0.03 # size 0.8
hihatPartial = sound "EmuHiHat:1" # amp 0.45 # room 0.03 # size 0.8
hihatOpen = sound "EmuHiHat:2" # amp 0.45 # room 0.03 # size 0.8
toms1 = amp 0.5 # room 0.07 # size 0.8 # shape 0.3 # hpf 250
toms1A = stack [sound "EmuToms:3" # toms1 # speed (2 ** (2 / 12)) # pan 0 # nudge 0.025, sound "EmuToms:3" # toms1 # speed (2 ** (2 / 12)) # pan 1]
toms1B = stack [sound "EmuToms:4" # toms1 # speed (2 ** (3 / 12)) # pan 0 # nudge 0.025, sound "EmuToms:4" # toms1 # speed (2 ** (3 / 12)) # pan 1]
toms1C = stack [sound "EmuToms:4" # toms1 # pan 0 # nudge 0.025, sound "EmuToms:4" # toms1 # pan 1]
toms1D = stack [sound "EmuToms:5" # toms1 # pan 0 # nudge 0.025, sound "EmuToms:5" # toms1 # pan 1]
toms2 = amp 0.5 # room 0.07 # size 0.8 # shape 0.3 # hpf 300
toms2A = sound "EmuToms:6" # toms2 # speed (2 ** (2 / 12)) # pan 0.35 -- f
toms2B = sound "EmuToms:7" # toms2 # speed (2 ** (3 / 12)) # pan 0.45 -- cs
toms2C = sound "EmuToms:7" # toms2 # pan 0.55 -- af
toms2D = sound "EmuToms:8" # toms2 # pan 0.65 -- f
snare1 = sound "EmuSnare:3" # amp 0.6 # room 0.2 # size 0.85 # dry 1.7 # shape 0.6 # crush 7.5 # speed 1.02 # hpf 250
snare2 = sound "EmuSnare:5" # amp 0.8 # room 0.04 # size 0.8 # shape 0.6 # hpf 200
snare3 = sound "EmuSnare:6" # amp 0.85 # room 0.04 # size 0.8 # shape 0.8 # hpf 200
snare4 = sound "EmuSnare:7" # amp 0.31 # room 0.15 # size 0.7 # shape 0.9 # crush 7.0 # speed 1.01
snare5 = sound "EmuSnare:9" # amp 1.0 # room 0.04 # size 0.8 # shape 0.85 # crush 6.0 # speed 1.02 # hpf 225

-- SAMPLES
metallic = sound "Metallic:0" # speed (2 ** (-6 / 12)) # amp 0.07 # shape 0.85 # coarse 2.1 # krush 0.2 # room 0.3 # size 0.8 
metallic = sound "Metallic:2" # amp 0.22 # shape 0.2 # coarse 1.5 # speed (2 ** (-8 / 12)) # room 0.6 # size 0.75 # hpf 300

-- VOCALS
vocals = sound "Vocals" # room 0.15 # size 0.8 # amp 0.5

-- EXPERIMENTATION 1
setbpm(130)
d1 $ slowcat ["c ~ ~ c c ~ c ~ ~ ~ c ~ c ~ ~ ~"] # kick
d2 $ note "~ c ~ c" # snare5
d3 $ slowcat ["~", "~ ~ ~ [c*8]"] # hihatClosed
d4 $ note "c c ~ c c ~ c c ~ c c ~ ~ ~ ~ ~" # hihatPartial
d5 $ slowcat ["~ ~ ~ c", "~"] # hihatOpen
d6 $ slowcat ["c", "~"] # cymbalCrash
d7 $ slowcat ["~", "c c c c"] # cymbalRide
d8 $ slowcat ["~ ~ [~ c ~ ~] c"] # clap

-- EXPERIMENTATION 2
setbpm(120)
d1 $ note "c*4" # kick
d2 $ note "~ c ~ c" # snare3
d3 $ slowcat ["~", "~", note "~ ~ ~ ~ ~ ~ ~ ~", note "~ ~ [c ~] [~ ~]"] # toms1A
d4 $ slowcat ["~", "~", note "c ~ ~ ~ ~ ~ ~ ~", note "~ c [~ c] [~ ~]"] # toms1B
d5 $ slowcat ["~", "~", note "~ ~ ~ c ~ ~ ~ ~", note "~ ~ [~ ~] [c ~]"] # toms1C
d6 $ slowcat ["~", "~", note "~ ~ ~ ~ ~ ~ c ~", note "~ ~ [~ ~] [~ c]"] # toms1D

-- EXPERIMENTATION 3
setbpm(138)
d1 $ slowcat [note "af2 af2 af2 bf2 ~ ~ ~ ~", note "~"] # legato "1 1 1 13 1 1 1 1 1" # prophecyLead
setbpm(114)
d1 $ slowcat [note "bf2 ~ ~ bf2 ~ ~ ~ ~" # legato "3 5 1", note "bf2 ~ ~ bf2 ~ df3 ~ ~" # legato "3 2 3 1", note "a2 ~ ~ a2 ~ ~ ~ ~" # legato "3 5 1", note "a2 ~ ~ a2 ~ c3 ~ ~" # legato "3 2 3 1"] # prophecyLead

-- EXPERIMENTATION 4
setbpm(87)
makeSideChain 3 0 0.4 0.003 0.02
d1 $ note "c*4" # kick
d2 $ note "~ c ~ c" # snare4
d3 $ slowcat [note "c", note "~", note "~", note "~ ~ ~ c"] # cymbalCrash # speed "<1 1 1 -1>" # end "<1 1 1 0.74>" # gain "1.0 0.74 0.74 0.74"
d4 $ slowcat [note "[c3*4]*2 [d3*4]*2", note "[ef3*4]*2 [[f3*4] [g3*4]]", note "[af3*4]*2 [g3*4]*2", note "[f3*4]*2 [[ef3*4] [b2*4]]"] # bass
d5 $ slowcat [note "c ~ c ~ c ~ c c ~ ~ c ~ c ~ c c", note "~ ~ c ~ c ~ c c ~ ~ c ~ c ~ c c", note "c ~ c ~ c ~ c c ~ ~ c ~ c ~ c c", note "c ~ c ~ c ~ c c ~ c c ~ c ~ c c"] # hihatClosed
d5 $ slowcat [note "c ~ c ~ c c c c ~ c c ~ c c c c", note "~ c c ~ c c c c ~ c c ~ c ~ c c", note "c ~ c ~ c c c c ~ c c ~ c c c c", note "~ c c ~ c ~ c c [c c c ~] ~ c ~ c c c c"] # hihatClosed
d5 $ slowcat [note "~ c c c c ~ c c c ~ c c c ~ c c", note "~ c c c c ~ c c c ~ c c c ~ c c", note "c ~ c c c ~ c c c ~ c c c c c c", note "~ c c c c ~ c c c c c [c c c ~] ~ c c c"] # hihatClosed
d5 $ slowcat [note "c*16", note "[[c*4] [c*4] [c*4] [c c [c c c ~] ~]]", note "c*16", note "[[c*4] [c*4] [c*4] [c c [c*4] [c*4]]]"] # hihatClosed
d6 $ slowcat [note "[[~ ~ ~ c5] [ds5 ~ ~ d5 ~ ~ c5 ~]]", note "[[~ ~ ~ c5] [ds5 ~ ~ b4 ~ ~ d5 ~]]", note "[[~ ~ ~ c5] [ds5 ~ ~ d5 ~ ~ c5 ~]]", note "[[~ ~ f5 ~ ~ ~ c5 ~] [ds5 ~ ~ b4 ~ ~ d5 ~]]"] # metallic
clearSideChain 3 0

-- EXPERIMENTATION 5
setbpm(60)
d1 $ slowcat [note "c c [~ ~ ~ c] c", note "c c [~ c ~ c] c"] # kick
d2 $ note "~ c ~ c" # snare1

hush