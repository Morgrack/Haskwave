-- SETUP
do 
    setbpm(75)
    makeSidechain 0 3 0.8 0.001 0.1
    makeSidechain 1 3 0.8 0.001 0.1
    makeSidechain 2 3 0.5 0.001 0.04
    makeSidechain 9 3 0.85 0.001 0.1

-- INTRO
do
    panic
    resetCycles
    let filterSweep min = hpf $ rangex 20000 min $ (slow 8 saw)
    d1 $ slowcat [note "[[af5 e5] [ef5 b4]]*2", note "[af5 e5] [ef5 b4] [bf4 b4] [df5 ef5]"] # eventHorizonLead # filterSweep 20
    d2 $ slowcat [note "af3 ~ ~ ~" # legato 7.3, note "~ ~ ~ a3", note "b3 ~ ~ ~" # legato 7.3, note "~ ~ ~ a3"] # eventHorizonMid # filterSweep 20
    d3 $ slowcat [note "ef3*16", note "[ef3*4] [ef3*4] [ef3*4] [e3*4]", note "fs3*16", note "[fs3*4] [fs3*4] [fs3*4] [e3*4]"] # noTurningBackBass # filterSweep 20

-- CHORUS
do
    d1 $ slowcat [note "[[af5 e5] [ef5 b4]]*2", note "[af5 e5] [ef5 b4] [bf4 b4] [df5 ef5]"] # eventHorizonLead
    d2 $ slowcat [note "af3 ~ ~ ~" # legato 7.3, note "~ ~ ~ a3", note "b3 ~ ~ ~" # legato 7.3, note "~ ~ ~ a3"] # eventHorizonMid
    d3 $ slowcat [note "ef3*16", note "[ef3*4] [ef3*4] [ef3*4] [e3*4]", note "fs3*16", note "[fs3*4] [fs3*4] [fs3*4] [e3*4]"] # noTurningBackBass
    d4 $ note "c*4" # kick
    d5 $ note "[~ c]*2" # snare
    d6 $ slowcat ((replicate 7 (note "~")) ++ [note "~ ~ [~ c5] [~ ~]"]) # toms2 # pan 0.25 --ef
    d7 $ slowcat ((replicate 7 (note "~")) ++ [note "~ ~ [~ ~] [b4 ~]"]) # toms3 # pan 0.5 --bf
    d8 $ slowcat ((replicate 7 (note "~")) ++ [note "~ ~ [~ ~] [~ bf4]"]) # toms4 # pan 0.7 --gf

-- VERSE
do
    d1 $ slowcat 
        [
            note "[[af5 e5] [ef5 b4]]*2", note "[af5 e5] [ef5 b4] [af5 gf5] [af5 ef5]",
            note "[[af5 e5] [ef5 b4]]*2", note "[af5 e5] [ef5 b4] [af5 gf5] [ef5 e5]",
            note "[[af5 e5] [ef5 b4]]*2", note "[af5 e5] [ef5 b4] [af5 gf5] [af5 df5]",
            note "[[af5 e5] [ef5 b4]]*2", note "[af5 e5] [ef5 b4] [b5 bf5] [fs5 bf5]"
        ]
        # eventHorizonLead
    d2 silence
    d9 $ slowcat ((replicate 4 (note "~")) ++ (replicate 4 (note "c*8" # hihatClosed # gain "<1 0.8>*8")))

-- CHORUS
do
    d1 $ slowcat [note "[[af5 e5] [ef5 b4]]*2", note "[af5 e5] [ef5 b4] [bf4 b4] [df5 ef5]"] # eventHorizonLead
    d2 $ slowcat [note "af3 ~ ~ ~" # legato 7.3, note "~ ~ ~ a3", note "b3 ~ ~ ~" # legato 7.3, note "~ ~ ~ a3"] # eventHorizonMid
    d9 silence

-- VERSE
do
    d1 $ slowcat 
        [
            note "[[af5 e5] [ef5 b4]]*2", note "[af5 e5] [ef5 b4] [af5 gf5] [af5 ef5]",
            note "[[af5 e5] [ef5 b4]]*2", note "[af5 e5] [ef5 b4] [af5 gf5] [ef5 e5]",
            note "[[af5 e5] [ef5 b4]]*2", note "[af5 e5] [ef5 b4] [af5 gf5] [af5 df5]",
            note "[[af5 e5] [ef5 b4]]*2", note "[af5 e5] [ef5 b4] [b5 bf5] [fs5 bf5]"
        ]
        # eventHorizonLead
    d2 silence
    d9 $ slowcat ((replicate 4 (note "~")) ++ (replicate 4 (note "c*8" # hihatClosed # gain "<1 0.8>*8")))

-- CHORUS
do
    d1 $ slowcat [note "[[af5 e5] [ef5 b4]]*2", note "[af5 e5] [ef5 b4] [bf4 b4] [df5 ef5]"] # eventHorizonLead
    d2 $ slowcat [note "af3 ~ ~ ~" # legato 7.3, note "~ ~ ~ a3", note "b3 ~ ~ ~" # legato 7.3, note "~ ~ ~ a3"] # eventHorizonMid
    d9 silence

-- BRIDGE
do
    d4 silence
    d5 silence
    d6 $ slowcat ((replicate 6 (note "~")) ++ [note "~ ~ ~ ~", note "[c5 ~] ~ ~ [c5 ~ ~]"]) # toms2 # pan 0.25 --ef
    d7 $ slowcat ((replicate 6 (note "~")) ++ [note "~ ~ ~ ~", note "[~ ~ ~ b4] ~ [~ b4] [~ b4 ~]"]) # toms3 # pan 0.5 --bf
    d8 $ slowcat ((replicate 6 (note "~")) ++ [note "~ ~ ~ ~" ,note "~ [~ bf4] ~ [~ ~ bf4]"]) # toms3 # pan 0.7 --gf
    d9 $ slowcat ((replicate 6 (note "c*4")) ++ [note "c*8", note "[c*4] [[c*2] [c*3]]"]) # hihatClosed
    d10 $ slowcat [note "~", note "~", note "~", note "~", note "~", note "~", note "~", note "~ ~ ~ ~ ~ ~ ~ a6" # legato 2] # eventHorizonBrass

-- CHORUS (x2)
do 
    d1 $ slowcat [note "[[~ e5] [ef5 b4]]*2", note "[~ e5] [ef5 b4] [bf4 b4] [df5 ef5]"] # eventHorizonLead
    d4 $ note "c*4" # kick
    d5 $ note "[~ c]*2" # snare
    d6 silence
    d7 silence
    d8 silence
    d9 silence
    d10 $ slowcat [note "~ af6 ~ ~ ~ ~ ~ ~" # legato 14.5, note "~ ~ ~ ~ ~ ~ ~ gf6" # legato 2, note "~ af6 ~ ~ ~ ~ ~ ~" # legato 14.5, note "~ ~ ~ ~ ~ ~ ~ a6" # legato 2] # eventHorizonBrass

-- OUTRO
do 
    d2 $ slowcat [note "af3 ~ ~ ~" # legato 7.3, note "~ ~ ~ gf3", note "af3 ~ ~ ~" # legato 7.3, note "~ ~ ~ a3"] # eventHorizonMid
    d3 silence
    d5 silence

hush

