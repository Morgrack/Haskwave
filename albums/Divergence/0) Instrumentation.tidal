-- IMPORTS
import qualified Sound.Osc.Fd as O
import qualified Sound.Osc.Transport.Fd.Udp as O

-- SIDECHAINING
scUdp <- O.openUdp "127.0.0.1" 57120

createSidechain sourceOrbit controlOrbit slopeAbove clampTime relaxTime = do 
    O.sendMessage scUdp (O.message "/createSidechain" [O.int32 sourceOrbit, O.int32 controlOrbit, O.float slopeAbove, O.float clampTime, O.float relaxTime])

deleteSidechain sourceOrbit controlOrbit = do
    O.sendMessage scUdp (O.message "/deleteSidechain" [O.int32 sourceOrbit, O.int32 controlOrbit])

clearSidechains = do
    O.sendMessage scUdp (O.message "/clearSidechains" [])

-- SYNTHESIZERS
waveform = pF "waveform"
unison = pF "unison"
detune1 = pF "detune1"
detune2 = pF "detune2"
scatter1 = pF "scatter1"
scatter2 = pF "scatter2"
instability = pF "instability"
phase = pF "phase"
pulse = pF "pulse"

-- UTILS
accelerateSemitones semitones = 2 ** (semitones / 12) - 1
chorus (cAmp, cPan, cWidth, cNudge) (pattern) = stack [pattern # amp (cAmp / 2) # pan (cPan - (cWidth / 2)) # nudge cNudge, pattern # amp (cAmp / 2) # pan (cPan + (cWidth / 2))]
setBPM bpm = setcps(bpm / 60 / 4) -- in case setbpm does not exist

-- SAMPLES
anvil = sound "Metallic:0" # amp 0.08 # shape 0.85 # krush 0.25 # coarse (1.25 + rand * 0.25) # speed (2 ** (-6 / 12)) # room 0.2 # size 0.7
marchingKick = sound "EmuKick:0" # amp 1.0
marchingSnare = sound "EmuSnare:0" # amp 1.0

-- E-MU DRUMULATOR
cymbal = sound "OberheimCymbals:0" # amp 0.18 # shape 0.8 # coarse 1.6 # room 0.4 # size 0.7
hihat = chorus (0.3, 0.5, 0.8, 0.005) (sound "EmuHiHat:1" # coarse 1.6)
kick = sound "EmuKick:3" # amp 0.9 # coarse 1.535 # octersub 0.25
snare1 = sound "EmuSnare:1" # amp 0.7 # shape 0.7 # crush 4 # coarse 1.37 # hpf 175 # end 0.66
snare2 = sound "EmuSnare:5" # amp 2.8 # shape 0.2 # coarse 1.47 # hpf 200 # room 0.12 # size 0.7
snare3 = sound "EmuSnare:8" # amp 1.1 # shape 0.7 # coarse 1.6 # hpf 175
snare4 = sound "EmuSnare:9" # amp 0.4 # shape 0.9 # crush 7.0 # octersub 0.4 # speed 1.01 # room 0.12 # size 0.7
snare5 = sound "EmuSnare:11" # amp 1.3 # shape 0.8 # coarse 1.73 # hpf 190
toms = shape 0.3 # hpf 180
toms1 = toms # sound "EmuToms:8" # amp 0.85 # pan 0.3 -- d
toms2 = toms # sound "EmuToms:9" # amp 0.9 # pan 0.4 -- a
toms3 = toms # sound "EmuToms:9" # amp 0.9 # pan 0.55 # speed (2 ** (-4 / 12)) -- f
toms4 = toms # sound "EmuToms:10" # amp 0.75 # pan 0.65 -- d

-- BASS
bassLFO = 30 -- 12 for The Knife's Edge, 30 for Divergence, 20 for Killing Factory, 18 for Upwards Descent, 15 for Emergence
bassRelease = 0.17 -- 0.19 for The Knife's Edge, 0.17 for Divergence, 0.21 for Killing Factory, 0.145 for Upwards Descent, 0.16 for Emergence
bass1 = chorus (0.27, 0.5, 0.8, 0) (sound "supernoise" # sustain 0.4 # release bassRelease # voice 1.0 # distort 0.15 # lpf (bassLFO * 250))
bass2 = sound "moogan" # amp 0.6 # sustain 0.4 # release bassRelease # waveform 3 # unison 2 # detune1 0.02 # scatter1 0.8 # lfo (bassLFO * 0.75) # resonance 0.1 # instability 0.1
bass3 = sound "moogan" # amp 0.45 # sustain 0.4 # release bassRelease # waveform 2 # lfo bassLFO # resonance 0.35 # pulse 0.37 # octave 4 # instability 0.3
bass = stack [bass1, bass2, bass3] # shape 0.6 # room 0.4 # size 0.7 # coarse (bassLFO * 0.01 + 2.0) -- no coarse for Emergence

-- THREE BASS
threeBass1 = chorus (0.26, 0.5, 1.0, 0) (sound "supernoise" # voice 1.0 # bpf 3300 # crush 2)
threeBass2 = sound "moogan" # amp 0.52 # waveform 3 # unison 7 # detune1 0.015 # scatter1 1.0 # lfo 20 # rate 0 # resonance 0.4 # phase 0.0 # instability 0.2 # crush 3.5
threeBass3 = sound "moogan" # amp 0.6 # waveform 3 # unison 7 # detune1 0.009 # scatter1 0.9 # lfo 35 # rate 0 # resonance 0.4 # phase 0.7 # instability 0.1 # crush 2 # octave 4
threeBass4 = sound "moogan" # amp 0.4 # waveform 3 # unison 3 # detune1 0.009 # scatter1 0.7 # lfo 35 # rate 0 # resonance 0.4  # phase 0.2 # instability 0.1 # octave 4 
threeBass = stack [threeBass1, threeBass2, threeBass3, threeBass4] # shape 0.8 # distort 0.1 # room 0.25 # size 0.7

-- CHILD FIRST BASS
childFirstBass1 = chorus (0.5, 0.5, 1, 0) (sound "supernoise" # voice 1.0 # distort 0.7 # bpf 3000 # lpf 1500)
childFirstBass2 = sound "moogan" # amp 0.6 # waveform 3 # unison 4 # detune1 0.035 # scatter1 1.0 # lfo 50 # rate 0 # resonance 0.7 # crush 3.5 # instability 0.4 # hpf 250
childFirstBass3 = childFirstBass2 # amp 0.6 # unison 2 # scatter1 0.7 # octave 4 # hpf 20
childFirstBass4 = sound "moogan" # amp 0.45 # waveform 2 # lfo 50 # rate 0 # resonance 0.55 # pulse 0.37 # octave 4
childFirstBass = stack [childFirstBass1, childFirstBass2, childFirstBass3, childFirstBass4] # shape 0.6 # coarse 2.05 # room 0.3 # size 0.7

-- EXPERIMENT
setbpm(120)
createSidechain 8 0 0.65 0.005 0.05
d1 $ note "c*4" # kick
d2 $ note "~ c ~ c" # snare3
d3 $ note "c*16" # hihat
d4 $ slow 4 (note "c") # cymbal
d5 $ slowcat [note "~", note "~", note "~", note "~ ~ ~ [c ~ ~ ~]"] # toms1 # gain 1.1
d6 $ slowcat [note "~", note "~", note "~", note "~ ~ ~ [~ c ~ ~]"] # toms2 # gain 1.1
d7 $ slowcat [note "~", note "~", note "~", note "~ ~ ~ [~ ~ c ~]"] # toms3 # gain 1.1
d8 $ slowcat [note "~", note "~", note "~", note "~ ~ ~ [~ ~ ~ c]"] # toms4 # gain 1.1
d9 $ slowcat [note "g3*16", note "bf3*16", note "d3*16", note "d3*16"] # bass

hush
panic

