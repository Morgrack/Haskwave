setbpm(95)

-- very short snappy intro like wyrm of doom

-- chorus
d1 $ slowcat [note "fs5", note "~", note "f5", note "~", note "a5", note "~"] # sound "superpiano" # room 0.3 # size 0.9 --like event horizon mid but higher octave
d3 $ slowcat [note "fs3*16", note "fs3*16", note "f3*16", note "f3*16", note "a3*16", note "a3*16"] # sound "superpiano" # amp 0.2
-- growl synth swapping between ears on arpeggio downwards on the beat, 5 notes per chord to swap ears each phrase
-- hihat to match d3

-- on second part of chorus add this below
d2 $ slowcat [note "as5", note "~", note "a5", note "~", note "cs6", note "~"] # sound "superpiano" # room 0.3 # size 0.9

-- verse?
d4 $ slowcat [note "fs5 ~ ~ gs5", note "as5 ~ ~ fs5", note "a5 ~ ~ fs5", note "as5 ~ a5 gs5"] # sound "superpiano" # room 0.3 # size 0.9
d3 $ slowcat [note "fs3*16", note "f3*16", note "gs3*16", note "gs3*8 g3*8"] # sound "superpiano" # amp 0.2

clearSideChain 2 3

hush


--chorus verse for a bit then swap to fmin7????

-- be prepared to ditch this idea, it feels very jarring


-- ANOTHER IDEA
setbpm(70)
d1 $ slowcat [note "[e5 c5] [e5 c5] [e5 c5] fs5", note "[e5 c5] [e5 c5] [e5 c5] fs5", note "[e5 b4] [e5 b4] [e5 b4] fs5", note "[e5 b4] [e5 b4] [e5 b4] fs5"] # sound "superpiano" # room 0.3 # size 0.9
d2 $ slowcat [note ""]

d1 $ slowcat [note "c5 [~ a4] c5 d5", note "b4 [~ g4] b4 c5", note "a4 [~ [f4 g4]] a4 b4", note "g4"] # sound "superpiano" # room 0.3 # size 0.9
