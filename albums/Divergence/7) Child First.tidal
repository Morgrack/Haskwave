setbpm(120) --low growly range simple simple synth with marching
setbpm(100)

d1 $ slowcat [note "[fs4 fs4 e4 ~] [fs4 ~ e4 g4] [fs4 fs4 e4 ~] [a4 as4 b4 c5 cs5]", note "[fs4 fs4 e4 ~] [fs4 ~ e4 g4] [fs4 fs4 e4 ~] [a4 g4]"] # sound "superpiano" -- Behemoth style bass
d2 $ note "c*4" # kick
d3 $ slowcat [note "c c ~ c c ~ c c ~ c c ~ c ~ ~ ~", note "c c ~ c c ~ c c ~ c [c c c c] [c c c c] c ~ c c"] # hihat
d4 $ note "[~ c]*2" # sound "EmuSnare:0"
hush
