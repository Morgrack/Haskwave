-- INTRO
setbpm(80)
-- add knife sharpening samples getting progressively more distorted
makeSideChain 1 0 0.4 0.01 0.03
filterSweep = djf $ range 0 0.5 $ (slow 8 saw)
d1 $ slowcat ((replicate 7 ("c*4")) ++ ["c c c ~"]) # kick
d2 $ slowcat [note "[g3*4]*2 [af3*4]*2", note "[a3*4]*2 [bf3*4]*2", note "[fs3*4]*2 [g3*4]*2", note "[a3*4]*2 [bf3*4]*2"] # bass # filterSweep
hush

-- SECTION A
makeSideChain 2 0 0.85 0.01 0.03
d1 $ slowcat ((replicate 7 ("c*4")) ++ ["c c c ~"]) # kick
d2 $ slowcat [note "[g3*4]*2 [af3*4]*2", note "[a3*4]*2 [bf3*4]*2", note "[fs3*4]*2 [g3*4]*2", note "[a3*4]*2 [bf3*4]*2"] # bass
d3 $ slowcat [note "~", note "[~ ~ ~ ~ ~ ~ g5 ~ bf5 ~ ~ a5 ~ ~ gf5 ~]" # legato "1 2 3 3 25", note "~", note "[~ ~ ~ ~ ~ ~ g5 ~ bf5 ~ ~ gf5 ~ ~ a5 ~]" # legato "1 2 3 3 25"] # knifesEdgeLead
d4 $ slowcat (["~ 0 ~ ~ ~ ~ ~ ~"] ++ (replicate 7 ("~"))) # vocals
hush

-- SECTION B

-- SECTION C

-- SECTION D

-- OUTRO

hush