    d3 $ note "[c*2] [c*2] [c*2] [c*2] [c [c c c c c c c ~]] [c [c c c c c c c ~]] [c [c c c c c c c ~]]" # hihat # cut 1
    d4 $ note "f3 f3 f3 f3 gf3 f3 ef3" # threeBass # legato 1.02 # gain 0.96
