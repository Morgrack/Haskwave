-- IMPORTS
import qualified Sound.Osc.Fd as O
import qualified Sound.Osc.Transport.Fd.Udp as O

-- UTILS
scUdp <- O.openUdp "127.0.0.1" 57120

makeSideChain sourceOrbit controlOrbit slopeAbove clampTime relaxTime = do 
    O.sendMessage scUdp (O.message "/makeSidechain" [O.int32 sourceOrbit, O.int32 controlOrbit, O.float slopeAbove, O.float clampTime, O.float relaxTime])

clearSideChain sourceOrbit controlOrbit = do
    O.sendMessage scUdp (O.message "/clearSidechain" [O.int32 sourceOrbit, O.int32 controlOrbit])

chorus vBase vWidth pWidth sWidth aAmount p = stack [(p # voice (vBase + (vWidth / 2)) # pan (0.5 + (pWidth / 2)) # speed (1.0 + (sWidth / 2)) # amp aAmount), (p # voice (vBase - (vWidth / 2)) # pan (0.5 - (pWidth / 2)) # speed (1.0 - (sWidth / 2)) # amp aAmount)] 

setBPM bpm = setcps(bpm / 60 / 4) -- in case setbpm does not exist, uses 4/4 time signature

-- PROPHECY
prophecy1 = chorus 0.9 0.1 1.0 0.0 0.7 (sound "supersaw" # sustain 0.25 # release 0.25 # lfo 1.0 # rate 0.1 # resonance 0.7 # crush 2.5 # bpf 70 # bpq 10 # hpf 150)
prophecy2 = chorus 0.9 0.1 1.0 0.0 0.6 (sound "supersaw" # attack 0.05 # release 999 # lfo 1.0 # rate 0.1 # resonance 0.7 # crush 2.5 # bpf 70 # bpq 10 # hpf 120)
prophecy3 = chorus 8.0 0.1 0.9 0.0 0.5 (sound "supersaw" # attack 0.05 # release 999 # lfo 0.25 # rate 0.01 # resonance 0.9 # distort 0.7 # bpf 50 # bpq 5 # hpf 200)
prophecy4 = chorus 1.0 0.0 0.8 0.0 0.45 (sound "supernoise" # attack 0.05 # release 999 # resonance 0.2 # distort 0.25 # phasdp 0.7 # phasr 5.0 # hpf 150)
prophecy5 = chorus 0.7 0.1 0.7 0.0 0.2 (sound "supersaw" # attack 0.05 # release 999 # lfo 7.0 # rate 0.005 # resonance 0.01 # hpf 100 # lpf 7000)
prophecy6 = sound "supersaw" # voice 0.05 # amp 0.2 # attack 0.05 # release 999 # lfo 1.0 # rate 0.001 # octave 4 # lpf 200
prophecy = stack [prophecy1, prophecy2, prophecy3, prophecy4, prophecy5, prophecy6] # room 0.15 # size 0.9

-- BASS
bass1 = chorus 0.8 0.1 0.8 0.02 0.15 (sound "supersaw" # sustain 0.2 # release 0.13 # lfo 16.0 # resonance 0.3 # shape 0.8 # distort 0.3 # hpf 500)
bass2 = chorus 1.2 0.1 0.6 0.04 0.5 (sound "supersaw" # attack 0.04 # sustain 0.2 # release 0.15 # lfo 10.0 # resonance 0.25 # shape 0.4 # hpf 100)
bass3 = sound "supersaw" # voice 0.1 # amp 0.7 # attack 0.04 # release 0.15 # lfo 1.0 # octave 4 # lpf 100
bass = stack [bass1, bass2, bass3] # room 0.17 # size 0.8

-- DRUMS
clap = sound "EmuPercussion:3" # amp 1.2 # room 0.04 # size 0.8
cowbell = sound "EmuPercussion:7" # amp 0.8 # room 0.02 # size 0.8
heartbeat = sound "EmuKick:9" # amp 1.0 # room 0.05 # size 0.8 # lpf 2500
kick = sound "EmuKick:2" # amp 1.2 # shape (-0.15) -- af
slap = sound "EmuPercussion:9" # amp 1.0 # room 0.04 # size 0.8
swipe = sound "EmuPercussion:8" # amp 1.1 # room 0.04 # size 0.8
woodblock = sound "EmuPercussion:12" # amp 0.8 # room 0.01 # size 0.8
agogoHigh = sound "EmuPercussion:0" # amp 0.7 # room 0.1 # size 0.7 # distort 0.7 # hpf 250
agogoLow = sound "EmuPercussion:1" # amp 0.6 # room 0.1 # size 0.7 # distort 0.7
cymbalChina = sound "EmuCymbals:0" # amp 0.4 # room 0.15 # size 0.8
cymbalCrash = sound "OberheimCymbals:0" # amp 0.9 # room 0.15 # size 0.8 # speed 0.98
cymbalRide = sound "OberheimCymbals:1" # amp 0.4 # room 0.15 # size 0.8
hihatClosed = sound "EmuHiHat:0" # amp 0.4 # room 0.03 # size 0.8
hihatPartial = sound "EmuHiHat:1" # amp 0.6 # room 0.03 # size 0.8
hihatOpen = sound "EmuHiHat:2" # amp 0.6 # room 0.03 # size 0.8
toms1A = sound "EmuToms:3" # amp 1.0 # room 0.2 # size 0.8 # shape 0.2 # hpf 200 -- tune this
toms1B = sound "EmuToms:4" # amp 1.0 # room 0.2 # size 0.8 # shape 0.2 # hpf 200 -- tune this
toms1C = sound "EmuToms:4" # amp 1.0 # room 0.2 # size 0.8 # shape 0.2 # hpf 200 -- tune this
toms1D = sound "EmuToms:5" # amp 1.0 # room 0.2 # size 0.8 # shape 0.2 # hpf 200 -- tune this
toms2A = sound "EmuToms:6" # amp 0.5 # room 0.07 # size 0.8 # shape 0.3 # hpf 300 # speed (2 ** (2 / 12)) # pan 0.35 -- f
toms2B = sound "EmuToms:7" # amp 0.5 # room 0.07 # size 0.8 # shape 0.3 # hpf 300 # speed (2 ** (3 / 12)) # pan 0.45 -- cs
toms2C = sound "EmuToms:7" # amp 0.5 # room 0.07 # size 0.8 # shape 0.3 # hpf 300 # pan 0.55 -- af
toms2D = sound "EmuToms:8" # amp 0.5 # room 0.07 # size 0.8 # shape 0.3 # hpf 300 # pan 0.65 -- f
snare1 = sound "EmuSnare:3" # amp 0.6 # room 0.15 # size 0.7 # shape 0.7 # crush 7.5 # speed 1.02 # hpf 250
snare2 = sound "EmuSnare:5" # amp 0.8 # room 0.04 # size 0.8 # shape 0.6 # hpf 200
snare3 = sound "EmuSnare:6" # amp 0.8 # room 0.04 # size 0.8 # shape 0.8 # hpf 200
snare4 = sound "EmuSnare:7" # amp 0.3 # room 0.15 # size 0.7 # shape 0.9 # crush 7.0 # speed 1.01
snare5 = sound "EmuSnare:9" # amp 1.0 # room 0.04 # size 0.8 # shape 0.85 # crush 6.0 # speed 1.02 # hpf 225

-- VOCALS
vocals = sound "Vocals" # room 0.15 # size 0.8 # amp 0.5

-- EXPERIMENTATION 1
setbpm(120)
d1 $ slowcat ["c ~ ~ c c ~ c ~ ~ ~ c ~ c ~ ~ ~"] # kick
d2 $ note "~ c ~ c" # snare3
d3 $ slowcat ["~", "~ ~ ~ [c*8]"] # hihatClosed
d4 $ note "c c ~ c c ~ c c ~ c c ~ ~ ~ ~ ~" # hihatPartial
d5 $ slowcat ["~ ~ ~ c", "~"] # hihatOpen
d6 $ slowcat ["c", "~"] # cymbalCrash
d7 $ slowcat ["~", "c c c c"] # cymbalRide
d8 $ slowcat ["~ ~ [~ c ~ ~] c"] # clap

-- EXPERIMENTATION 2
setbpm(120)
d1 $ note "c*4" # kick
d2 $ note "~ c ~ c" # snare3
d3 $ slowcat ["~", "~", note "~ ~ ~ ~ ~ ~ ~ ~", note "~ ~ [c ~] [~ ~]"] # toms2A
d4 $ slowcat ["~", "~", note "c ~ ~ ~ ~ ~ ~ ~", note "~ c [~ c] [~ ~]"] # toms2B
d5 $ slowcat ["~", "~", note "~ ~ ~ c ~ ~ ~ ~", note "~ ~ [~ ~] [c ~]"] # toms2C
d6 $ slowcat ["~", "~", note "~ ~ ~ ~ ~ ~ c ~", note "~ ~ [~ ~] [~ c]"] # toms2D

-- EXPERIMENTATION 3
setbpm(138)
d1 $ slowcat [note "af2 af2 af2 bf2 ~ ~ ~ ~", note "~"] # legato "1 1 1 13 1 1 1 1 1" # prophecy
setbpm(114)
d1 $ slowcat [note "bf2 ~ ~ bf2 ~ ~ ~ ~" # legato "3 5 1", note "bf2 ~ ~ bf2 ~ df3 ~ ~" # legato "3 2 3 1", note "a2 ~ ~ a2 ~ ~ ~ ~" # legato "3 5 1", note "a2 ~ ~ a2 ~ c3 ~ ~" # legato "3 2 3 1"] # prophecy

-- EXPERIMENTATION 4
setbpm(90)
makeSideChain 3 0 0.4 0.003 0.02
d1 $ note "c*4" # kick
d2 $ note "~ c ~ c" # snare3
d3 $ slowcat [note "c", note "~", note "~", note "~ ~ ~ c"] # cymbalCrash # speed "<1 1 1 -1.02>" # gain "1.0 0.77 0.77 0.77"
d4 $ slowcat [note "[c3*4]*2 [d3*4]*2", note "[ef3*4]*2 [[f3*4] [g3*4]]", note "[af3*4]*2 [g3*4]*2", note "[f3*4]*2 [[ef3*4] [b2*4]]"] # bass
clearSideChain 3 0 

hush